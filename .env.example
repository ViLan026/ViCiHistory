GEMINI_MAX_OUTPUT_TOKENS=2048
GEMINI_TIMEOUT_MS=120000
GEMINI_MAX_RETRIES=2

TOP_K=5
MAX_CLAIMS_PER_INPUT=8
MAX_INPUT_CHARS=12000
MAX_EVIDENCE_CHARS=2500
MIN_EVIDENCE_SCORE=0
