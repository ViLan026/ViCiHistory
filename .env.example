APP_NAME=history_verifier_ai
APP_ENV=local
PORT=8080

HF_TOKEN=

QDRANT_URL=https://YOUR_CLUSTER.qdrant.io
QDRANT_API_KEY=replace_me
QDRANT_COLLECTION_NAME=history_aiteamvn_chunk_256
QDRANT_TIMEOUT_SECONDS=60

EMBEDDING_MODEL=AITeamVN/Vietnamese_Embedding

GEMINI_API_KEY=replace_me
